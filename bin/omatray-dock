#!/usr/bin/env python3
"""SUPER+M: minimize the focused docked app, or dock the focused web app first."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import omatray_dock as d  # noqa: E402


def minimize(address):
    # Docking never closes anything, so with the shell down the window is parked
    # anyway; the widget picks up the entry and the window on its next probe.
    if not d.park(address):
        d.move_to_hidden(address)


def main():
    w = d.active_window()
    if not w:
        d.notify("Nothing to dock", "No focused window.")
        return
    cls = w.get("class") or ""
    if not cls.startswith("chrome-"):
        d.notify("Can't dock this window", "Only Chromium web apps can be docked.")
        return
    if d.is_popout(w):
        d.notify("Can't dock a popout", "Focus the app's main window and try again.")
        return
    loaded = d.load_dock()
    if loaded is None:
        d.notify("Dock file is malformed", "Fix or remove %s; nothing was changed." % d.dock_path())
        return
    doc, apps = loaded
    if d.find_by_class(apps, cls) is None:
        taken = {a.get("id") for a in doc["apps"] if isinstance(a, dict)}
        entry = d.entry_from_class(cls, taken)
        if entry is None:
            d.notify("Can't dock this window", "No web-app launcher found for %s." % cls)
            return
        doc["apps"].append(entry)
        d.write_dock(doc)
    minimize(w["address"])


if __name__ == "__main__":
    main()
