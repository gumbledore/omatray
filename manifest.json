{
  "schemaVersion": 1,
  "id": "io.github.gumbledore.omatray",
  "name": "omatray",
  "version": "0.1.0",
  "author": "gumbledore",
  "license": "MIT",
  "description": "Dock any web app into the bar: minimize to tray, unread badge, show/hide",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "omatray",
    "description": "Dock any web app into the bar: minimize to tray, unread badge, show/hide",
    "category": "Status",
    "allowMultiple": false,
    "defaultSection": "right",
    "schema": [
      {
        "key": "pollInterval",
        "type": "integer",
        "label": "Window poll interval (ms)",
        "default": 2000
      }
    ]
  }
}
